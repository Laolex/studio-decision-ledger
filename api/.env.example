# Copy to api/.env and fill in. api/.env is gitignored; never commit real values.
#
# From the ClickHouse Cloud console: select your service -> Connect -> Native.
# The dialog shows the host and an example clickhouse-client command.

# HOSTNAME.REGION.CSP.clickhouse.cloud  (no protocol prefix, no port)
CLICKHOUSE_HOST=

# 8443 = HTTPS interface (what the MCP server uses)
# 9440 = secure native protocol (what clickhouse-client uses)
CLICKHOUSE_PORT=8443

CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

CLICKHOUSE_SECURE=true
CLICKHOUSE_VERIFY=true
CLICKHOUSE_DATABASE=sdl
